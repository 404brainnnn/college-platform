generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model College {
  id                 String   @id @default(cuid())
  slug               String   @unique
  name               String
  location           String
  state              String
  fee                Int
  rating             Float
  placementPercent   Int
  averagePackageLpa  Float
  highestPackageLpa  Float
  courseTags         String[]
  exams              String[]
  minRank            Int
  overview           String
  established        Int
  ownership          String
  campusSizeAcres    Int
  courses            Course[]
  reviews            Review[]
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt
}

model Course {
  id        String  @id @default(cuid())
  name      String
  duration  String
  seats     Int
  collegeId String
  college   College @relation(fields: [collegeId], references: [id], onDelete: Cascade)
}

model Review {
  id        String  @id @default(cuid())
  author    String
  rating    Float
  comment   String
  collegeId String
  college   College @relation(fields: [collegeId], references: [id], onDelete: Cascade)
}
